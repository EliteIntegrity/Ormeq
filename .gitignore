#################
## Ormeq
#################
# Photographs taken by tools/shot.ps1 -- evidence for a conversation,
# not part of the game. Keep the tool, not its output.
shots/

# The vendored SDL3 development packages are deliberately tracked, so that a
# clone builds with nothing beside it. They must survive the build-output
# rules above -- "x64/" in particular would swallow the import libraries and
# leave a third-party folder that looks complete and does not link.
!third-party/
!third-party/**

# The compiled resource. ormeq.rc is the source; this is build output that
# was committed once and never regenerated.
*.res

# Local art delivery folders.
batch-*/

# CMake build trees and copied runtime binaries (also applies to fresh clones).
/out/
/out-sdl3/
/out-none/
/ormeq.exe
/ormeq-sdl3.exe
/ormeq-none.exe
/SDL3.dll
/SDL3_ttf.dll
/SDL3_image.dll

# Optional audio ships only in playable packages, never in source/history.
/lib/xtra/sound/pack/
/_audio-src/
/lib/xtra/music/pack/
/_music-src/

# Optional sprite artwork and private production records.
/lib/tiles/pack/
/_art-src/scenery/
/_art-src/supplemental/
sprite-recipe.json

